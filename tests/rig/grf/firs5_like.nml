/*
 * A set with FIRS 5's id (F1250009) and nothing else, so that a scene can be
 * "a game with FIRS 5" without the real FIRS: what the game does about the
 * CZTR wagons hangs on that id alone (HasFirs5()). Played by the scene
 * cztrvymena (see README.md).
 *
 *     nmlc -c -l grf/lang --grf firs5_like.grf grf/firs5_like.nml
 */
grf {
	grfid: "\F1\25\00\09";
	name: string(STR_FIRS5_NAME);
	desc: string(STR_FIRS5_DESC);
	version: 1;
	min_compatible_version: 1;
}

cargotable { COAL }

/*
 * A set that brings students (STUD) under its own name, as the industry sets
 * do. The game calls them studentky whatever the set says, and the coffeeshop
 * takes them (NameStudentCargo(), COFFEESHOP_CARGOES). Played by the scene
 * studentky (see README.md).
 *
 *     nmlc -c -l grf/lang --grf studenti.grf grf/studenti.nml
 */
grf {
	grfid: "RIGs";
	name: string(STR_STUD_NAME);
	desc: string(STR_STUD_DESC);
	version: 1;
	min_compatible_version: 1;
}

item(FEAT_CARGOS, s_stud, 40) {
	property {
		number: 40;
		type_name: string(STR_STUD_CARGO);
		unit_name: string(STR_STUD_CARGO);
		type_abbreviation: string(STR_STUD_CARGO);
		units_of_cargo: string(STR_STUD_CARGO);
		items_of_cargo: string(STR_STUD_CARGO);
		weight: 1;
		is_freight: 0;
		cargo_classes: bitmask(CC_PASSENGERS);
		cargo_label: "STUD";
		price_factor: 100;
		penalty_lowerbound: 10;
		single_penalty_length: 100;
		station_list_colour: 152;
		cargo_payment_list_colour: 152;
		capacity_multiplier: 1;
	}
}

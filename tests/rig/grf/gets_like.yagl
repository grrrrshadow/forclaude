switch<Trains, 0xFD, PrimaryDWord> // Action02 variable
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000000: 0x8000;
    };
    default: 0x00FD;
}
switch<Trains, 0xFD, PrimaryDWord> // Action02 variable
{
    expression:
    {
        value1 = variable[0x10] >> 8 & 0x000000FF;

        value2 = variable[0x1A] & 0x00000001;
        value1 = SignedCmp(value1, value2);

        value2 = variable[0x1A] & 0x00000001;
        value1 = SignedMin(value1, value2);

        value2 = variable[0x1A] & 0x00000001;
        value1 = BitwiseXor(value1, value2);

        value2 = variable[0x1A] & 0x80000000;
        value1 = Multiply(value1, value2);

        value2 = variable[0x1A] & 0x00000000;
        value1 = Addition(value1, value2);

        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);

        value2 = variable[0x10] >> 8 & 0x000000FF;
        value1 = Assign(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x00FE;
        0x00000001: 0x00FF;
    };
    default: 0x00FD;
}
switch<Trains, 0xFD, PrimaryDWord> // Action02 variable
{
    expression:
    {
        value1 = variable[0x47] & 0x000000FF;
    };
    ranges:
    {
        0x00000000: 0x00FD;
    };
    default: 0x00FE;
}

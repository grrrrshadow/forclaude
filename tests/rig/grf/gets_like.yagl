// Wagons named the way GETS names its own -- what the wagon is, and its kind in
// quotes -- for the name rule (IsGreenLayerWagon(), IsCarCarrierWagon()), and one
// of them drawing its coal the way GETS does: the wagon as one picture, the load
// as a second one over it (CB_FLAG_MORE_SPRITES), painted in the range GETS
// recolours by cargo. Played by the scene getsjmena (see README.md): the Eaos
// and its livery carry marijuana with only the load green, the chosen carriers
// take road vehicles, the Ssla Köln and the Eaoss take neither. Of the open
// wagons the player picked by kind and town, the Om Breslau takes marijuana;
// the Omm 55, an Om of another town and the Om Ludwigshafen, which the player
// left out, do not.
// Sprite set 0 the wagon, 1 the load, 2 the load of an empty wagon (nothing, as
// GETS draws it); layer 0 the wagon, layer 1 the load -- GETS's loadstack. The
// quotes in the names are written {dq} (yagl's name for the code 0x22); the game
// reads them as plain quotes either way (TranslateTTDPatchCodes()).
//     yagl -e <out>/gets_like.grf tests/rig/grf      (the battery builds it every run)
yagl_version: "";
grf_format: Container2;
optional_info // Action14
{
    INFO: 
    {
        VRSN: [ 0x01 0x00 0x00 0x00 ];
        MINV: [ 0x01 0x00 0x00 0x00 ];
        NPAR: [ 0x00 ];
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
grf // Action08
{
    grf_id: "RIGg";
    version: GRF8;
    name: "Rig: wagons named as GETS names them";
    description: "Wagons named what they are and then their kind in quotes, and one drawing its coal as a layer over the wagon, as GETS does.";
}
properties<GlobalSettings, 0x0000> // Action00
{
    // instance_id: 0x0000
    {
        cargo_translation_table: "COAL";
    }
    // instance_id: 0x0001
    {
        cargo_translation_table: "GOOD";
    }
}

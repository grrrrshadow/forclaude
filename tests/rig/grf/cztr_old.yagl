// A stand-in for CZTR Wagons-Cargo 1.0.0, the release the rig has not got: the
// set's id (4D490213) and that release's very name, which is how the game tells
// it from the set's other releases (IsWagonCargoExceptionGrf()), on the rig's
// one-layer St (st_old.yagl). Played by the scene cztrvymena (see README.md): a
// game with FIRS 5 and another release of the set plays this one in its place.
//     yagl -e <out>/cztr_old.grf tests/rig/grf      (the battery builds it every run)
yagl_version: "";
grf_format: Container2;
optional_info // Action14
{
    INFO: 
    {
        VRSN: [ 0x01 0x00 0x00 0x00 ];
        MINV: [ 0x01 0x00 0x00 0x00 ];
        NPAR: [ 0x00 ];
        PALS: [ 0x44 ];
        BLTR: [ 0x38 ];
    }
}
grf // Action08
{
    grf_id: "MI\x02\x13";
    version: GRF8;
    name: "CZTR Wagons-Cargo 1.0.0";
    description: "Rig: a stand-in for CZTR Wagons-Cargo 1.0.0 -- the set's id and that release's name on the rig's one-layer St.";
}

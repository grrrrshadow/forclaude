// One of two tiny cargo sets that the scene nakladysdilene plays together (see
// README.md). Each switches the game's cargoes off and brings three cargoes of
// its own under the ids 0, 1 and 2 -- the same ids, as every set numbers its
// cargoes from 0. This one: passengers, coal and a cargo of its own (RIGA).
//     yagl -e <out>/cargo_a.grf tests/rig/grf      (the battery builds it every run)
yagl_version: "";
grf_format: Container2;
optional_info // Action14
{
    INFO: 
    {
        VRSN: [ 0x01 0x00 0x00 0x00 ];
        MINV: [ 0x01 0x00 0x00 0x00 ];
        NPAR: [ 0x00 ];
        PALS: [ 0x41 ];
        BLTR: [ 0x38 ];
    }
}
grf // Action08
{
    grf_id: "RIGa";
    version: GRF8;
    name: "Rig: cargo set A";
    description: "Switches the game's cargoes off and brings passengers, coal and RIGA under the ids 0, 1 and 2.";
}
strings<Cargos, default, 0xDC00*> // <feature, language, first_id> Action04, Default
{
    /* 0xDC00 */ "PassengersA";
    /* 0xDC01 */ "CoalA";
    /* 0xDC02 */ "RigCargoA";
}
properties<Cargos, 0x0000> // Action00
{

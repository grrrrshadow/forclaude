switch<RoadVehicles, 0x16, PrimaryDWord> // radiator: black, lightening of its own in register 101: start 128, stop 255, 200 at the lightest (register 100)
{
    expression:
    {
        value1 = variable[0x1A] & 0x00141414;
        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);
        value2 = variable[0x1A] & 0x00C8FF80;
        value1 = Assign(value1, value2);
        value2 = variable[0x1A] & 0x00000101;
        value1 = TempStore(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x840F;
    };
    default: 0x840F;
}

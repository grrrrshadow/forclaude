switch<RoadVehicles, 0x18, PrimaryDWord> // body: paints mask 0x60-0x67, lightening in register 100: start 100, stop 200, 255 at the lightest were there no stop
{
    expression:
    {
        value1 = variable[0x1A] & 0x00FFC864;
        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x8060;
    };
    default: 0x8060;
}
switch<RoadVehicles, 0x19, PrimaryDWord> // the colours (callback 1C1, variable 10): the mask of a detail (option FF), the colour of an option
{
    expression:
    {
        value1 = variable[0x10] & 0x0000FFFF;
    };
    ranges:
    {
        0x000000FF: 0x80C6;
        0x000001FF: 0x0018;
        0x000002FF: 0x8068;
        0x00000000: 0x0010;
        0x00000001: 0x0011;
        0x00000002: 0x0012;
        0x00000100: 0x0013;
        0x00000101: 0x0014;
        0x00000102: 0x0015;
        0x00000200: 0x0016;
        0x00000201: 0x0017;
    };
    default: 0x8400;
}
switch<RoadVehicles, 0x04, PrimaryDWord> // the callbacks
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x000001C0: 0x0003;
        0x000001C1: 0x0019;
    };
    default: 0x0002;
}

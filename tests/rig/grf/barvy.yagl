// The rig's set for the colours of the game's configurator (vehicle_config.h,
// true_colour.h). A road vehicle whose set names five details -- the cab, the
// body and the radiator are colours, the crew and a beacon are not -- through
// callback 1C0, and gives the colours through callback 1C1: for each colour
// detail the first of the eight mask indices it paints (option 0xFF), and for
// each option its colour as 0x00RRGGBB in register 100 (result 40F). The cab
// paints the company colour's indices 0xC6-0xCD and lightens as usual; the
// body paints 0x60-0x67 and gives the player's three numbers of its
// lightening in register 100 (start 100, stop 200, 255 at the lightest were
// there no stop); the radiator paints 0x68-0x6F, its black option lightens
// otherwise (register 101). The cab's last option and the crew are no colour:
// The cab's Tatra orange fades with age to brick red over two years in steps
// of one (registers 102 to 104), the rig's short span of the player's twenty.
// the cab is then the company colour, as drawn. The beacon is detail 4, read
// in variable 5D. The pictures are grey 32bpp with a mask, zin8 only:
// flat areas at the lightness where each colour is exactly itself, a row at
// 254 and one darker, so the rig can read the colours back.
// Written in the colleague's yagl dialect, as konfig.yagl.
//     yagl -e <out>/barvy.grf tests/rig/grf      (the battery builds it every run)
yagl_version: "";
grf_format: Container2;
optional_info // Action14: the feature test, answered on bit 9 of 0x9D
{
    FTST: 
    {
        NAME: default, "decouple_vehicle_config";
        MINV: [ 0x01 0x00 ];
        SETP: [ 0x09 ];
    }
}
grf // Action08
{
    grf_id: "RIGb";
    version: GRF8;
    name: "Rig: barvy";
    description: "Colours for the configurator: cab, body, radiator";
}
if_act7 (is_bit_set(global_var[0x9D] & 0xFF, 1 << 9)) // Action07: the game answered, skip the error
{
    skip_sprites: 0x01;
}
error_message<Fatal, default, 0xFF> // Action0B
{
    message: "Tento GRF patri ke hre OpenTTD decouple by Karel Macha a jinde nefunguje.";
}
properties<RoadVehicles, 0x0058> // Action00
{
    {
        long_introduction_date: date(1920/1/1);
        model_life_years: 255;
        vehicle_life_years: 30;
        reliability_decay_speed: 20;
        climate_availability: Temperate | Arctic | Tropical | Toyland;
        cargo_type: 0x00;
        cargo_capacity: 0x10;
        loading_speed: 0x02;
        sprite_id: 0xFF;
        speed_2_kmh: 0x30;
        power_10_hp: 0x01;
        weight_quarter_tons: 0x04;
        cost_factor: 0x08;
        running_cost_factor: 0x04;
        running_cost_base: 0x00004C48;
        callback_flags_mask: 0x00;
    }
}

sprite_groups<RoadVehicles, 0x00> // Action02 basic: set 0
{
    primary_spritesets: [ 0x0000 ];
    secondary_spritesets: [ 0x0000 ];
}
sprite_groups<RoadVehicles, 0x01> // Action02 basic: set 1
{
    primary_spritesets: [ 0x0001 ];
    secondary_spritesets: [ 0x0001 ];
}
switch<RoadVehicles, 0x02, PrimaryDWord> // the picture by the beacon, detail 4 (variable 5D, its first byte)
{
    expression:
    {
        value1 = variable[0x5D] & 0x000000FF;
    };
    ranges:
    {
        0x00000000: 0x0000;
    };
    default: 0x0001;
}
switch<RoadVehicles, 0x03, PrimaryDWord> // the texts of the configurator (callback 1C0, variable 10)
{
    expression:
    {
        value1 = variable[0x10] & 0x0000FFFF;
    };
    ranges:
    {
        0x000000FF: 0x8000;
        0x00000000: 0x8001;
        0x00000001: 0x8002;
        0x00000002: 0x8003;
        0x00000003: 0x8004;
        0x000001FF: 0x8005;
        0x00000100: 0x8006;
        0x00000101: 0x8007;
        0x00000102: 0x8008;
        0x000002FF: 0x8009;
        0x00000200: 0x800A;
        0x00000201: 0x800B;
        0x000003FF: 0x800C;
        0x00000300: 0x800D;
        0x00000301: 0x800E;
        0x000004FF: 0x800F;
        0x00000400: 0x8010;
        0x00000401: 0x8011;
    };
    default: 0x8400;
}
switch<RoadVehicles, 0x10, PrimaryDWord> // cab: Tatra orange (register 100), fading to brick red (register 102) over 2 years (103) in steps of 1 (104)
{
    expression:
    {
        value1 = variable[0x1A] & 0x00E8641E;
        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);
        value2 = variable[0x1A] & 0x00B4503C;
        value1 = Assign(value1, value2);
        value2 = variable[0x1A] & 0x00000102;
        value1 = TempStore(value1, value2);
        value2 = variable[0x1A] & 0x00000002;
        value1 = Assign(value1, value2);
        value2 = variable[0x1A] & 0x00000103;
        value1 = TempStore(value1, value2);
        value2 = variable[0x1A] & 0x00000001;
        value1 = Assign(value1, value2);
        value2 = variable[0x1A] & 0x00000104;
        value1 = TempStore(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x840F;
    };
    default: 0x840F;
}
switch<RoadVehicles, 0x11, PrimaryDWord> // cab: white (register 100)
{
    expression:
    {
        value1 = variable[0x1A] & 0x00F0F0F0;
        value2 = variable[0x1A] & 0x00000100;
        value1 = TempStore(value1, value2);
    };
    ranges:
    {
        0x00000000: 0x840F;
    };
    default: 0x840F;
}

sprite_groups<RoadVehicles, 0x00> // Action02 basic: set 0
{
    primary_spritesets: [ 0x0000 ];
    secondary_spritesets: [ 0x0000 ];
}
sprite_groups<RoadVehicles, 0x01> // Action02 basic: set 1
{
    primary_spritesets: [ 0x0001 ];
    secondary_spritesets: [ 0x0001 ];
}
switch<RoadVehicles, 0x02, PrimaryDWord> // the picture by the player's choices (variable 5C)
{
    expression:
    {
        value1 = variable[0x5C] & 0x0000FFFF;
    };
    ranges:
    {
        0x00000000: 0x0000;
    };
    default: 0x0001;
}
switch<RoadVehicles, 0x05, PrimaryDWord> // the alien: hidden (401) unless the cart is pushed (variable 5C, byte 1), so only on a vehicle
{
    expression:
    {
        value1 = variable[0x5C] & 0x0000FF00;
    };
    ranges:
    {
        0x00000100: 0x8003;
    };
    default: 0x8401;
}
switch<RoadVehicles, 0x03, PrimaryDWord> // the texts of the configurator (callback 1C0, variable 10)
{
    expression:
    {
        value1 = variable[0x10] & 0x0000FFFF;
    };
    ranges:
    {
        0x000000FF: 0x8000;
        0x00000000: 0x8001;
        0x00000001: 0x8002;
        0x00000002: 0x0005;
        0x000001FF: 0x8004;
        0x00000100: 0x8005;
        0x00000101: 0x8006;
    };
    default: 0x8400;
}
switch<RoadVehicles, 0x04, PrimaryDWord> // the callbacks
{
    expression:
    {
        value1 = variable[0x0C] & 0x0000FFFF;
    };
    ranges:
    {
        0x000001C0: 0x0003;
    };
    default: 0x0002;
}
feature_graphics<RoadVehicles> // Action03
{
    livery_override: false;
    default_set_id: 0x0004;
    feature_ids: [ 0x0058 ];
    cargo_types:
    {
        0xFF: 0x0004;
    };
}
